# VibeToken 中转站配置 —— 复制本文件为 .env 并填入你的 key（.env 已被 gitignore，不会提交）
# 模型 ID 用 GET https://vibetoken.cn/v1/models 查实时列表，挑能力强的填。

LLM_BASE_URL=https://vibetoken.cn/v1
LLM_API_KEY=sk-rb-在这里填你的key

# 文本模型：负责 FormatSpec 抽取和角色标注（要求 JSON 输出稳定）
LLM_MODEL=deepseek/deepseek-v4-pro

# 视觉模型：负责排版自检（需支持图片输入；不填则默认复用 LLM_MODEL）
LLM_VISION_MODEL=
